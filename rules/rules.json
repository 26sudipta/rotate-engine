  "seasons": {
    "citation_id": "emran2022",
    "quote": "There are three cropping seasons in Bangladesh: Rabi (typically mid-November to mid-March, also known as winter or boro season) Kharif -1 (typically mid-March to mid-July, also known as pre-monsoon or spring) Kharif -2 (typically mid-July to mid-November, also known as monsoon or aman season)",
    "order_citation_id": "nasim2017",
    "order_quote": "Writing CP generally started from Rabi or Boro season followed by Kharif-I or Aus then Kharif-II or Aman season.",
    "dry_season_quote": "The problem of salinity increases in the dry season. [nasim2017]",
    "defs": {
      "rabi": {
        "label": "Rabi (winter, Boro season)",
        "months": "mid-November to mid-March",
        "dry": true
      },
      "kharif1": {
        "label": "Kharif-1 (pre-monsoon, summer)",
        "months": "mid-March to mid-July",
        "dry": true
      },
      "kharif2": {
